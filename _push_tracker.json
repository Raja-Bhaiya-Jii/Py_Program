      "file": "gcd_lcm.py",
      "commit_msg": "Day 18: GCD and LCM calculator",
      "code": "\"\"\"Program 18: GCD and LCM Calculator\nComputes the greatest common divisor and least common multiple.\"\"\"\n\ndef gcd(a, b):\n    while b:\n        a, b = b, a % b\n    return a\ndef lcm(a, b):\n    return abs(a * b) // gcd(a, b) if a and b else 0\ndef main():\n    a = int(input(\"Enter first number: \"))\n    b = int(input(\"Enter second number: \"))\n    print(f\"GCD: {gcd(a, b)}\")\n    print(f\"LCM: {lcm(a, b)}\")\n\nif __name__ == \"__main__\":\n    main()\n"
